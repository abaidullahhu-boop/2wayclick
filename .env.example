# Contact form delivery via Resend (https://resend.com).
# Copy to .env.local and fill in. Without a key, development logs enquiries to
# the console instead of sending; production refuses to send and shows the
# visitor the email address instead.
RESEND_API_KEY=

# Optional overrides. CONTACT_FROM must be on a domain verified in Resend.
# Defaults: from "2wayclick website <info@2wayclick.com>", to info@2wayclick.com.
# CONTACT_FROM="2wayclick website <noreply@2wayclick.com>"
# CONTACT_TO=info@2wayclick.com
